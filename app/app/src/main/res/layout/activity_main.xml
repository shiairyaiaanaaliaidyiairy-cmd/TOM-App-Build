<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#07080D" android:orientation="vertical"
    android:gravity="center" android:padding="32dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="TOM" android:textSize="72sp" android:textStyle="bold"
        android:textColor="#FF2D2D" android:fontFamily="sans-serif-black"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="الجمهورية العربية السورية" android:textColor="#99F4F5F7"
        android:textSize="14sp" android:layout_marginBottom="40dp"/>
    <Button android:id="@+id/btn_start" android:layout_width="200dp"
        android:layout_height="60dp" android:text="تشغيل التطبيق"
        android:textColor="#FFFFFF" android:backgroundTint="#14FFFFFF"/>
</LinearLayout>
